---
/*
 * Footer — gallery colophon (a wall placard, not a 4-column sitemap).
 *
 * One quiet strip: the pigment-swatch mark, a one-line studio statement, and
 * a single inline row of directory links. The signature stays the maker's
 * palette; everything else is placard-quiet. Legal/RSS wiring unchanged.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getCategoriesWithCounts, slugifyTag } from '~/lib/blog'

const rooms = (await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
  name: category,
  slug: slugifyTag(category),
}))
const links = [
  { name: 'The wall', href: '/' },
  { name: 'All works', href: '/blog/' },
  { name: 'Series', href: '/series/' },
  { name: 'Rooms', href: '/categories/' },
  { name: 'Archive', href: '/archive/' },
  { name: 'About', href: '/about/' },
]
---
<footer class="colophon" role="contentinfo">
  <div class="col-inner">
    <div class="col-mark">
      <span class="col-swatch" aria-hidden="true"></span>
      <p class="col-statement">
        The Maker's Bench — a working studio wall of daily drawing, hand-lettering,
        and the honest business of turning a craft into a living.
      </p>
    </div>
    <nav class="col-nav" aria-label="Directory">
      {links.map((l) => <a href={l.href}>{l.name}</a>)}
    </nav>
    {rooms.length > 0 && (
      <nav class="col-rooms mono" aria-label="Rooms">
        {rooms.map((r) => <a href={`/categories/${r.slug}/`}>{r.name}</a>)}
      </nav>
    )}
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-arts"
    appName="The Maker's Bench"
    bio="A working studio wall: daily drawing, hand-lettering, and earning from what you make."
    rss="/rss.xml"
  />
</footer>
<style>
  .colophon {
    margin-top: clamp(4rem, 9vw, 6rem);
    background: var(--paper-2);
    color: var(--ink);
    border-top: 1px solid var(--rule);
  }
  .col-inner {
    max-width: var(--container-page, 1100px);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.25rem) 1.5rem;
    display: grid;
    gap: 1.75rem;
  }
  .col-mark { display: flex; align-items: flex-start; gap: 0.875rem; max-width: 60ch; }
  .col-swatch {
    width: 12px; height: 34px; flex: 0 0 auto; margin-top: 0.2rem;
    background:
      linear-gradient(var(--accent), var(--accent)) 0 0 / 100% calc(100% / 3) no-repeat,
      linear-gradient(var(--accent-warm), var(--accent-warm)) 0 50% / 100% calc(100% / 3) no-repeat,
      linear-gradient(var(--ochre), var(--ochre)) 0 100% / 100% calc(100% / 3) no-repeat;
    border: 1px solid var(--ink);
    border-radius: 2px;
  }
  .col-statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .col-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .col-nav a {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .col-nav a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .col-rooms { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .col-rooms a {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .col-rooms a:hover { color: var(--accent); }
</style>

---
/*
 * PigmentField — the signature gallery-tile artwork.
 *
 * No post ships a photograph, so each tile earns an image the honest way:
 * a deterministic dye-wash field generated from the post's title + vertical
 * pigment. Same title always renders the same canvas (seeded PRNG), so the
 * wall is stable across builds. Layered soft-edged washes + a torn ink stroke
 * + a raw-ochre registration dot read as a hand-mixed pigment study, not a
 * placeholder gradient.
 */
import { postVertical, type Vertical } from '~/lib/blog'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post?: CollectionEntry<'blog'>
  /** Override seed + vertical directly (used by the hero plate). */
  seed?: string
  vertical?: Vertical
  /** Aspect flag drives tile height variance on the wall. */
  ratio?: 'tall' | 'wide' | 'square'
}

const { post, seed: seedProp, vertical: vertProp, ratio = 'square' } = Astro.props
const vert: Vertical = vertProp ?? (post ? postVertical(post) : 'personal')
const seedStr = seedProp ?? post?.data.title ?? 'the makers bench'

// tiny deterministic PRNG (mulberry32) seeded from the title hash
function hash(s: string): number {
  let h = 2166136261
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i)
    h = Math.imul(h, 16777619)
  }
  return h >>> 0
}
function rng(seed: number) {
  let a = seed
  return () => {
    a |= 0
    a = (a + 0x6d2b79f5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}
const r = rng(hash(seedStr))
const uid = `pf-${hash(seedStr).toString(36)}`

// vertical pigment → CSS custom prop the SVG paints with
const pigment: Record<Vertical, string> = {
  dev: 'var(--v-dev)',
  finance: 'var(--v-finance)',
  culture: 'var(--v-culture)',
  health: 'var(--v-health)',
  personal: 'var(--v-personal)',
}
const ink = pigment[vert]

// three drifting wash blobs
const blobs = Array.from({ length: 3 }, () => ({
  cx: 20 + r() * 60,
  cy: 20 + r() * 60,
  rx: 26 + r() * 34,
  ry: 26 + r() * 34,
  rot: r() * 180,
  op: 0.28 + r() * 0.34,
}))
// one torn brush stroke (a quadratic ribbon)
const sx = 8 + r() * 20
const sy = 30 + r() * 40
const stroke = {
  x1: sx,
  y1: sy,
  cx: sx + 30 + r() * 30,
  cy: sy - 30 + r() * 60,
  x2: 74 + r() * 18,
  y2: 20 + r() * 55,
  w: 2.5 + r() * 4,
}
// registration dot (raw ochre) — the maker's alignment mark
const dot = { x: 74 + r() * 16, y: 74 + r() * 14, rr: 2.2 + r() * 1.6 }
const grain = r()
---

<svg
  class={`pigment-field pf--${ratio}`}
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-hidden="true"
  style={`--pf-ink:${ink};`}
>
  <defs>
    <filter id={`${uid}-soft`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3.4" />
    </filter>
    <filter id={`${uid}-grain`}>
      <feTurbulence type="fractalNoise" baseFrequency={0.7 + grain * 0.5} numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer><feFuncA type="linear" slope="0.06" /></feComponentTransfer>
      <feComposite operator="over" in2="SourceGraphic" />
    </filter>
  </defs>

  <rect width="100" height="100" fill="var(--pf-paper, var(--paper-2))" />

  <g filter={`url(#${uid}-soft)`}>
    {blobs.map((b) => (
      <ellipse
        cx={b.cx}
        cy={b.cy}
        rx={b.rx}
        ry={b.ry}
        transform={`rotate(${b.rot} ${b.cx} ${b.cy})`}
        fill="var(--pf-ink)"
        opacity={b.op}
      />
    ))}
  </g>

  <path
    d={`M ${stroke.x1} ${stroke.y1} Q ${stroke.cx} ${stroke.cy} ${stroke.x2} ${stroke.y2}`}
    fill="none"
    stroke="var(--pf-ink)"
    stroke-width={stroke.w}
    stroke-linecap="round"
    opacity="0.7"
  />

  <circle cx={dot.x} cy={dot.y} r={dot.rr} fill="var(--ochre)" opacity="0.9" />
  <rect width="100" height="100" filter={`url(#${uid}-grain)`} opacity="0.5" />
</svg>

<style>
  .pigment-field {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--paper-2);
  }
</style>

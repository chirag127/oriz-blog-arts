---
/**
 * PostCard — a gallery tile ("wall work"). A framed pigment-field canvas with
 * a caption plate underneath, the way a piece hangs in a gallery: image first,
 * a small wall label (desk pigment · category), the title as the work's name,
 * and a mono date/reading foot. No hairline ledger rows — this is a wall, not
 * a feed. Used by every listing so the whole site reads as one hung wall.
 *
 * Variable tile heights (tall/wide/square) are chosen deterministically from
 * the title so a CSS-columns masonry wall never reflows between builds.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'
import PigmentField from '~/components/blog/PigmentField.astro'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const vert = postVertical(post)

// deterministic aspect from the title so the wall is stable
function h(s: string): number {
  let n = 0
  for (let i = 0; i < s.length; i++) n = (n * 31 + s.charCodeAt(i)) >>> 0
  return n
}
const ratio = (['tall', 'square', 'wide', 'square'] as const)[h(title) % 4]
---

<article class="tile" data-vertical={vert} data-ratio={ratio}>
  <a class="tile-link" href={href}>
    <span class="tile-frame">
      <PigmentField post={post} ratio={ratio} />
    </span>
    <span class="tile-plate">
      <span class="tile-label">
        <span class="tile-swatch" aria-hidden="true"></span>
        <span class="tile-desk">{verticalLabel(vert)}</span>
        <span class="tile-cat">{category}</span>
      </span>
      <h3 class="tile-title">{title}</h3>
      <span class="tile-desc">{description}</span>
      <span class="tile-foot">
        <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
        {readingTime && <span class="tile-rt">{readingTime}</span>}
      </span>
    </span>
  </a>
  <a class="tile-cat-link" href={`/categories/${slugifyTag(category)}/`} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .tile {
    position: relative;
    --v: var(--v-personal);
    break-inside: avoid;
    margin-bottom: clamp(1.5rem, 3.5vw, 2.75rem);
  }
  .tile[data-vertical='dev'] { --v: var(--v-dev); }
  .tile[data-vertical='finance'] { --v: var(--v-finance); }
  .tile[data-vertical='culture'] { --v: var(--v-culture); }
  .tile[data-vertical='health'] { --v: var(--v-health); }

  .tile-link {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }

  /* the framed canvas — a hung piece, thin mount + hairline frame */
  .tile-frame {
    display: block;
    position: relative;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    padding: 8px;
    box-shadow: 0 1px 0 var(--rule-strong);
    transition:
      transform var(--dur-base, 200ms) var(--ease-out, ease),
      box-shadow var(--dur-base, 200ms) var(--ease-out, ease);
  }
  .tile-frame :global(.pigment-field) {
    aspect-ratio: 1 / 1;
    height: auto;
  }
  .tile[data-ratio='tall'] .tile-frame :global(.pigment-field) { aspect-ratio: 3 / 4; }
  .tile[data-ratio='wide'] .tile-frame :global(.pigment-field) { aspect-ratio: 4 / 3; }

  .tile-link:hover .tile-frame {
    transform: translateY(-3px);
    box-shadow: 0 10px 22px -14px color-mix(in oklab, var(--ink) 45%, transparent);
  }
  .tile-link:focus-visible { outline: none; }
  .tile-link:focus-visible .tile-frame {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* wall-label plate under the piece */
  .tile-plate {
    display: block;
    padding: 0.75rem 0.125rem 0;
  }
  .tile-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .tile-swatch {
    width: 8px; height: 8px; flex: 0 0 auto;
    background: var(--v);
    border-radius: 1px;
  }
  .tile-desk { color: var(--v); font-weight: 500; }
  .tile-cat { color: var(--ink-mute); }

  .tile-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.18;
    margin: 0.5rem 0 0;
    color: var(--ink);
  }
  .tile-link:hover .tile-title { color: var(--accent); }

  .tile-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-mute);
    margin-top: 0.375rem;
  }
  .tile-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-top: 0.625rem;
  }
  .tile-rt::before { content: '·'; margin-right: 0.625rem; color: var(--rule-strong, var(--rule)); }

  .tile-cat-link {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tile-cat-link:focus-visible {
    width: auto; height: auto; clip: auto;
    top: 8px; left: 8px;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-frame { transition: none; }
    .tile-link:hover .tile-frame { transform: none; }
  }
</style>

---
/**
 * /  — The Maker's Bench homepage: a gallery wall.
 *
 * The page is a canvas, not a feed. A quiet wall-label thesis sits top-left in
 * a wide field of negative space; below it the works hang as a CSS-columns
 * masonry wall of pigment-field tiles (PostCard). A thin "rooms + series"
 * directory closes the wall. No masthead, no lead-story broadsheet, no ruled
 * ledger — those were the newspaper. This is the studio wall.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import PostCard from '~/components/blog/PostCard.astro'
import PigmentField from '~/components/blog/PigmentField.astro'
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  getSeriesWithCounts,
  slugifyTag,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const works = allPosts.slice(0, 18)
const series = (await getSeriesWithCounts()).slice(0, 6)
const cats = (await getCategoriesWithCounts()).slice(0, 8)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout title="The Maker's Bench — a working studio wall" description={SITE_CONFIG.description} jsonLd={jsonLd} hideSidebar>
  <div class="canvas">
    {/* Hero = wall label. The thesis, hung top-left over open space. */}
    <section class="wall-label" aria-label="Introduction">
      <p class="wl-eyebrow mono"><span class="wl-swatch" aria-hidden="true"></span>Working studio · since 2019</p>
      <h1 class="wl-thesis">Make something<br />every single day.</h1>
      <p class="wl-dek">A wall of wet-paint work from the bench — daily drawing, hand-lettering, and the honest business of turning a craft into a living. Each piece below is generated from its own pigment.</p>
      <p class="wl-meta mono">{allPosts.length} works hung · newest first</p>
    </section>

    {/* The wall — masonry canvas of pigment-field tiles. */}
    {works.length > 0 ? (
      <section class="wall" aria-label="Latest works">
        {works.map((post) => <PostCard post={post} />)}
      </section>
    ) : (
      <section class="wall-empty">
        <span class="wall-empty-frame"><PigmentField seed="empty wall" vertical="culture" ratio="wide" /></span>
        <p class="mono">Wall's being hung. First works go up shortly.</p>
      </section>
    )}

    {/* Directory — rooms + series, quiet strip closing the wall. */}
    <section class="directory" aria-label="Browse the collection">
      {cats.length > 0 && (
        <div class="dir-col">
          <h2 class="dir-h mono">Rooms</h2>
          <ul class="dir-list">
            {cats.map((c) => (
              <li>
                <a href={`/categories/${slugifyTag(c.category)}/`}>
                  <span class="dir-name">{c.category}</span>
                  <span class="dir-count mono">{c.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {series.length > 0 && (
        <div class="dir-col">
          <h2 class="dir-h mono">Series</h2>
          <ul class="dir-list">
            {series.map((s) => (
              <li>
                <a href={`/series/${slugifyTag(s.series)}/`}>
                  <span class="dir-name">{s.series}</span>
                  <span class="dir-count mono">{s.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="dir-col dir-col--cta">
        <h2 class="dir-h mono">The archive</h2>
        <a class="dir-cta" href="/archive/">Walk the whole wall — all {allPosts.length} works →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .canvas {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.25rem);
  }

  /* ── Wall label (hero) ─────────────────────────────────────────────── */
  .wall-label {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2rem, 5vw, 3.5rem);
    max-width: 44ch;
  }
  .wl-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 1.25rem;
  }
  .wl-swatch {
    width: 26px; height: 9px; flex: 0 0 auto;
    background:
      linear-gradient(var(--accent), var(--accent)) 0 0 / calc(100% / 3) 100% no-repeat,
      linear-gradient(var(--accent-warm), var(--accent-warm)) calc(100% / 2) 0 / calc(100% / 3) 100% no-repeat,
      linear-gradient(var(--ochre), var(--ochre)) 100% 0 / calc(100% / 3) 100% no-repeat;
    border: 1px solid var(--ink);
    border-radius: 2px;
  }
  .wl-thesis {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 100, "SOFT" 60, "WONK" 1;
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.96;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .wl-dek {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    line-height: 1.55;
    color: color-mix(in oklab, var(--ink) 80%, var(--paper));
    margin: 1.5rem 0 0;
  }
  .wl-meta {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 1.25rem 0 0;
  }

  /* ── The wall — CSS columns masonry ────────────────────────────────── */
  .wall {
    column-gap: clamp(1.25rem, 3vw, 2.25rem);
    column-count: 1;
  }
  @media (min-width: 560px) { .wall { column-count: 2; } }
  @media (min-width: 960px) { .wall { column-count: 3; } }

  .wall-empty {
    display: grid;
    gap: 1rem;
    justify-items: center;
    padding-block: 3rem;
    color: var(--ink-mute);
  }
  .wall-empty-frame {
    display: block;
    width: min(420px, 80vw);
    border: 1px solid var(--rule);
    padding: 8px;
  }
  .wall-empty-frame :global(.pigment-field) { aspect-ratio: 4 / 3; height: auto; }

  /* ── Directory ─────────────────────────────────────────────────────── */
  .directory {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) { .directory { grid-template-columns: 1fr 1fr 1fr; } }

  .dir-h {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .dir-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .dir-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast, 120ms) ease, color var(--dur-fast, 120ms) ease;
  }
  .dir-list a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .dir-list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dir-name { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 500; letter-spacing: -0.01em; }
  .dir-count { font-size: 11px; color: var(--ink-mute); }

  .dir-cta {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  .dir-cta:hover { color: var(--accent); }
  .dir-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
